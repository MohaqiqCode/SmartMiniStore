<UserControl x:Class="SmartMiniStore.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="Reports" Style="{StaticResource TitleText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource BaseButton}"/>
            </StackPanel>

            <!-- Statistic cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                        Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Sales" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding TotalSales}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                        Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Revenue" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding TotalRevenueDisplay}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                        Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Best-Selling Product" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding BestSellingProduct}"
                                   FontSize="18" FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Low-Stock Items" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding LowStockCount}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Low-stock list -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Low-Stock Products"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,10"/>

                    <DataGrid ItemsSource="{Binding LowStockProducts}"
                              MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"        Binding="{Binding Name}"         Width="2*"/>
                            <DataGridTextColumn Header="Category"    Binding="{Binding CategoryName}" Width="*"/>
                            <DataGridTextColumn Header="Qty"         Binding="{Binding Quantity}"     Width="Auto"/>
                            <DataGridTextColumn Header="Min. Stock"  Binding="{Binding MinimumStock}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
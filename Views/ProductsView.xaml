<UserControl x:Class="SmartMiniStore.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: list + search -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Products" Style="{StaticResource TitleText}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox Width="280"
                         Style="{StaticResource BaseTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name"/>
                <Button Content="New"
                        Command="{Binding NewCommand}"
                        Style="{StaticResource BaseButton}"/>
                <Button Content="Edit"
                        Command="{Binding EditCommand}"
                        Style="{StaticResource BaseButton}"/>
                <Button Content="Delete"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButton}"/>
            </StackPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"          Binding="{Binding Name}"          Width="2*"/>
                    <DataGridTextColumn Header="Category"      Binding="{Binding CategoryName}"  Width="*"/>
                    <DataGridTextColumn Header="Price (AFN)"   Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                    <DataGridTextColumn Header="Qty"           Binding="{Binding Quantity}"      Width="Auto"/>
                    <DataGridTextColumn Header="Min"           Binding="{Binding MinimumStock}"  Width="Auto"/>
                    <DataGridTextColumn Header="Status"        Binding="{Binding StockStatus}"   Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- RIGHT: form -->
        <Border Grid.Column="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="6"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Category" Style="{StaticResource LabelText}"/>
                <ComboBox Style="{StaticResource BaseComboBox}"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding FormCategory}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Price (AFN)" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Quantity" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Minimum Stock" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding FormMinimumStock, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SuccessButton}"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource BaseButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
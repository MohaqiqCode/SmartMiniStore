<UserControl x:Class="SmartMiniStore.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sales" Style="{StaticResource TitleText}"/>

        <!-- NEW SALE PANEL -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Product" Style="{StaticResource LabelText}"/>
                    <ComboBox Style="{StaticResource BaseComboBox}"
                              ItemsSource="{Binding AvailableProducts}"
                              SelectedItem="{Binding FormProduct}"
                              DisplayMemberPath="Name"/>
                    <TextBlock Text="{Binding FormProductInfo}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,-4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Quantity" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource BaseTextBox}"
                             Text="{Binding FormQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Content="Record Sale"
                            Command="{Binding CreateSaleCommand}"
                            Style="{StaticResource SuccessButton}"
                            Padding="20,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HISTORY -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                CornerRadius="6"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Sales History"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,10"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="260"
                             Style="{StaticResource BaseTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by product name"/>
                    <DatePicker SelectedDate="{Binding FilterDate}"
                                Margin="4"
                                VerticalContentAlignment="Center"/>
                    <Button Content="Clear Filter"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource BaseButton}"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshHistoryCommand}"
                            Style="{StaticResource BaseButton}"/>
                </StackPanel>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Sales}"
                          SelectedItem="{Binding SelectedSale}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product"       Binding="{Binding ProductName}"     Width="2*"/>
                        <DataGridTextColumn Header="Qty"           Binding="{Binding Quantity}"        Width="Auto"/>
                        <DataGridTextColumn Header="Unit (AFN)"    Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Total (AFN)"   Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="*"/>
                        <DataGridTextColumn Header="Date"          Binding="{Binding SaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
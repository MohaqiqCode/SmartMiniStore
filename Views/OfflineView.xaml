<UserControl x:Class="SmartMiniStore.Views.OfflineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="6" Padding="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⚠"
                       FontSize="48"
                       Foreground="{StaticResource WarningBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Unable to connect to MongoDB"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Please make sure MongoDB is running on localhost:27017, then restart the application."
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>